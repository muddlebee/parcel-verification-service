NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/parcel_verification
REDIS_URL=redis://localhost:6379

API_KEY=dev-local-api-key

UPLOAD_DIR=./uploads

# Scales BullMQ backoff down for local/demo runs (1 = real seconds, e.g. 30s/60s/120s/240s/480s).
# Set higher in real deployments; kept low here so a reviewer isn't waiting 8 minutes to see "exhausted".
REGISTRY_RETRY_BASE_MS=2000
REGISTRY_MAX_ATTEMPTS=5
