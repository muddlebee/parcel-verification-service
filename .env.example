NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/parcel_verification
REDIS_URL=redis://localhost:6379

API_KEY=dev-local-api-key

UPLOAD_DIR=./uploads

# Scales BullMQ backoff down for local/demo runs (1 = real seconds, e.g. 30s/60s/120s/240s/480s).
# Set higher in real deployments; kept low here so a reviewer isn't waiting 8 minutes to see "exhausted".
REGISTRY_RETRY_BASE_MS=2000
REGISTRY_MAX_ATTEMPTS=5

# How long we wait for the stub partner to ack before it's a timeout.
REGISTRY_CALL_TIMEOUT_MS=3000

# Parallel jobs per worker (BullMQ concurrency). Default 1 was sequential.
# Submit: overlap partner I/O. Delivery: parallel loopback webhook POSTs.
REGISTRY_SUBMIT_CONCURRENCY=5
REGISTRY_DELIVERY_CONCURRENCY=5
