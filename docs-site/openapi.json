{
  "openapi": "3.0.3",
  "info": {
    "title": "Parcel Verification Service",
    "version": "1.0.0",
    "description": "BhoomiPe Parcel Verification Service — accepts a land parcel for verification, moves it through a state machine involving an external registry partner, and keeps a full audit trail of every state change.\n\n**Documents:** single attach takes a file picker plus a `document_type` dropdown, and the file is optional (omit it to record metadata only). Batch attach has one file picker per document type — upload each file under the field named after its type, in any combination; the field name is what classifies the document."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current version"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_TRANSITION"
              },
              "message": {
                "type": "string",
                "example": "Cannot move from 'verified' to 'under_verification'."
              },
              "request_id": {
                "type": "string",
                "example": "9c1f2e3a-..."
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "total_pages"
        ]
      },
      "SubmitParcelRequest": {
        "type": "object",
        "properties": {
          "parcel": {
            "type": "object",
            "properties": {
              "khata_no": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "example": "412/3"
              },
              "plot_no": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "example": "1187"
              },
              "district": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "example": "Khordha"
              },
              "tehsil": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "example": "Bhubaneswar"
              },
              "village": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "example": "Patia"
              },
              "area_sqft": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": true,
                "example": 12000
              },
              "claimed_ownership_since": {
                "type": "string",
                "format": "date",
                "example": "2011-04-18"
              }
            },
            "required": [
              "khata_no",
              "plot_no",
              "district",
              "tehsil",
              "village",
              "area_sqft",
              "claimed_ownership_since"
            ]
          },
          "owner": {
            "type": "object",
            "properties": {
              "full_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "example": "Anita Behera"
              },
              "mobile": {
                "type": "string",
                "pattern": "^\\+91[6-9]\\d{9}$",
                "example": "+919876543210"
              },
              "aadhaar_number": {
                "type": "string",
                "pattern": "^\\d{12}$",
                "example": "123412341234"
              },
              "pan_number": {
                "type": "string",
                "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
                "example": "ABCDE1234F"
              },
              "bank_account_number": {
                "type": "string",
                "pattern": "^[0-9]{6,20}$",
                "example": "50100123456789"
              },
              "ifsc": {
                "type": "string",
                "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$",
                "example": "HDFC0001234"
              }
            },
            "required": [
              "full_name",
              "mobile",
              "aadhaar_number",
              "pan_number",
              "bank_account_number",
              "ifsc"
            ]
          }
        },
        "required": [
          "parcel",
          "owner"
        ]
      },
      "CreateParcelResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "TransitionRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "from_state": {
            "type": "string",
            "nullable": true,
            "enum": [
              "submitted",
              "documents_pending",
              "under_verification",
              "verified",
              "rejected",
              "disputed",
              null
            ]
          },
          "to_state": {
            "type": "string",
            "enum": [
              "submitted",
              "documents_pending",
              "under_verification",
              "verified",
              "rejected",
              "disputed"
            ]
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "from_state",
          "to_state",
          "actor",
          "reason",
          "created_at"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "document_type": {
            "type": "string"
          },
          "original_file_name": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "document_type",
          "original_file_name",
          "content_type",
          "size_bytes",
          "uploaded_at"
        ]
      },
      "ParcelSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "khata_no": {
            "type": "string"
          },
          "plot_no": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "tehsil": {
            "type": "string"
          },
          "village": {
            "type": "string"
          },
          "area_sqft": {
            "type": "number"
          },
          "claimed_ownership_since": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "documents_pending",
              "under_verification",
              "verified",
              "rejected",
              "disputed"
            ]
          },
          "registry_sync_status": {
            "type": "string",
            "enum": [
              "idle",
              "queued",
              "retrying",
              "exhausted",
              "done"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "khata_no",
          "plot_no",
          "district",
          "tehsil",
          "village",
          "area_sqft",
          "claimed_ownership_since",
          "status",
          "registry_sync_status",
          "created_at",
          "updated_at"
        ]
      },
      "ParcelDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ParcelSummary"
          },
          {
            "type": "object",
            "properties": {
              "owner": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "example": "Anita Behera"
                  },
                  "mobile": {
                    "type": "string",
                    "pattern": "^\\+91[6-9]\\d{9}$",
                    "example": "+919876543210"
                  },
                  "aadhaar_number": {
                    "type": "string",
                    "pattern": "^\\d{12}$",
                    "example": "123412341234"
                  },
                  "pan_number": {
                    "type": "string",
                    "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
                    "example": "ABCDE1234F"
                  },
                  "bank_account_number": {
                    "type": "string",
                    "pattern": "^[0-9]{6,20}$",
                    "example": "50100123456789"
                  },
                  "ifsc": {
                    "type": "string",
                    "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$",
                    "example": "HDFC0001234"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "full_name",
                  "mobile",
                  "aadhaar_number",
                  "pan_number",
                  "bank_account_number",
                  "ifsc",
                  "id"
                ]
              },
              "documents": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Document"
                }
              },
              "history": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TransitionRecord"
                }
              }
            },
            "required": [
              "owner",
              "documents",
              "history"
            ]
          }
        ]
      },
      "ListParcelsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParcelSummary"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "total_pages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "limit",
              "total",
              "total_pages"
            ]
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "ManualTransitionRequest": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "submitted",
              "documents_pending",
              "under_verification",
              "verified",
              "rejected",
              "disputed"
            ],
            "example": "disputed"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "example": "Competing ownership claim filed by third party."
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "example": "ops:vineet"
          }
        },
        "required": [
          "to",
          "reason",
          "actor"
        ]
      },
      "RegistryCallbackRequest": {
        "type": "object",
        "properties": {
          "registry_reference_id": {
            "type": "string",
            "format": "uuid",
            "example": "7a1e0c3b-aaaa-4bbb-8ccc-000000000002"
          },
          "callback_id": {
            "type": "string",
            "minLength": 1,
            "example": "partner-cb-99213"
          },
          "result": {
            "type": "string",
            "enum": [
              "verified",
              "rejected"
            ],
            "example": "verified"
          },
          "remarks": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000,
            "example": "Title clear, no encumbrance found."
          },
          "delivered_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-06T12:00:00Z"
          }
        },
        "required": [
          "registry_reference_id",
          "callback_id",
          "result",
          "delivered_at"
        ]
      },
      "RegistryCallbackResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "duplicate_ignored"
            ]
          },
          "parcel_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "status",
          "parcel_id"
        ]
      },
      "VerifyParcelRequest": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "verified",
              "rejected",
              "timeout",
              "failure",
              "duplicate"
            ],
            "description": "Debug-only: force the stub partner's outcome. Omit for a weighted-random outcome (mostly verified, sometimes rejected/timeout/failure). Not part of a real partner's API.",
            "example": "timeout"
          }
        }
      },
      "VerifyParcelResponse": {
        "type": "object",
        "properties": {
          "registry_reference_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "registry_reference_id"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "uptime_seconds": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "uptime_seconds"
        ]
      },
      "BatchDocumentsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "count"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness/readiness probe for a container orchestrator.",
        "servers": [
          {
            "url": "/"
          }
        ],
        "responses": {
          "200": {
            "description": "Service is up and can reach Postgres and Redis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is up but a dependency (Postgres or Redis) is unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parcels": {
      "post": {
        "tags": [
          "Parcels"
        ],
        "summary": "Submit a parcel for verification.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitParcelRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parcel created, status 'submitted' then immediately auto-advanced to 'documents_pending'.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateParcelResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Parcels"
        ],
        "summary": "List parcels, filterable by status and district, paginated.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "submitted",
                "documents_pending",
                "under_verification",
                "verified",
                "rejected",
                "disputed"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "district",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListParcelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parcels/{id}": {
      "get": {
        "tags": [
          "Parcels"
        ],
        "summary": "Retrieve a parcel with its full verification history and owner record.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b3f1c2a4-1234-4a9b-8b1e-000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParcelDetail"
                }
              }
            }
          },
          "404": {
            "description": "No parcel with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parcels/{id}/documents": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Attach a document to a parcel. File is optional — omit or send empty to record metadata only (local disk when bytes are present).",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b3f1c2a4-1234-4a9b-8b1e-000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional PDF/PNG/JPEG (max 10MB). Omit or empty for metadata-only."
                  },
                  "document_type": {
                    "type": "string",
                    "enum": [
                      "sale_deed",
                      "record_of_rights",
                      "encumbrance_certificate",
                      "owner_id_proof",
                      "other"
                    ],
                    "description": "Document classification.",
                    "example": "sale_deed"
                  }
                },
                "required": [
                  "document_type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Attached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "Bad document_type, or file content doesn't match declared mime type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No parcel with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parcels/{id}/documents/batch": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Attach multiple documents in one request (all-or-nothing). Upload each file under the field named after its document type; max 10 files total. For a metadata-only record, use the single attach endpoint.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b3f1c2a4-1234-4a9b-8b1e-000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "sale_deed": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 10,
                    "description": "Files to file as 'sale_deed'. PDF/PNG/JPEG, max 10MB each."
                  },
                  "record_of_rights": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 10,
                    "description": "Files to file as 'record_of_rights'. PDF/PNG/JPEG, max 10MB each."
                  },
                  "encumbrance_certificate": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 10,
                    "description": "Files to file as 'encumbrance_certificate'. PDF/PNG/JPEG, max 10MB each."
                  },
                  "owner_id_proof": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 10,
                    "description": "Files to file as 'owner_id_proof'. PDF/PNG/JPEG, max 10MB each."
                  },
                  "other": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "maxItems": 10,
                    "description": "Files to file as 'other'. PDF/PNG/JPEG, max 10MB each."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "All documents attached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchDocumentsResponse"
                }
              }
            }
          },
          "400": {
            "description": "No files attached, more than 10 files, unknown field name, or a file whose content doesn't match its declared mime type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No parcel with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parcels/{id}/verify": {
      "post": {
        "tags": [
          "Parcels"
        ],
        "summary": "Mark a parcel ready for verification — triggers the async registry-partner call.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b3f1c2a4-1234-4a9b-8b1e-000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyParcelRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted — moved to under_verification, registry call enqueued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyParcelResponse"
                }
              }
            }
          },
          "404": {
            "description": "No parcel with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Parcel isn't in a state this can be called from (must be documents_pending).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/callbacks/registry": {
      "post": {
        "tags": [
          "Callbacks"
        ],
        "summary": "Registry partner delivers a verification result. Idempotent, unauthenticated per the brief.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistryCallbackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed — or ignored as a duplicate delivery of a callback_id already recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryCallbackResponse"
                }
              }
            }
          },
          "404": {
            "description": "No parcel with that registry_reference_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A different, non-duplicate callback conflicts with the parcel's current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/parcels/{id}/transitions": {
      "post": {
        "tags": [
          "Parcels"
        ],
        "summary": "Manually transition a parcel (ops-triggered). Only verified<->disputed is reachable this way.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "b3f1c2a4-1234-4a9b-8b1e-000000000001"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualTransitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transition applied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParcelDetail"
                }
              }
            }
          },
          "404": {
            "description": "No parcel with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Not a transition this endpoint (or the state machine) allows from the current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
